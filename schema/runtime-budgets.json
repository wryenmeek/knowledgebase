{
  "schema_version": 1,
  "severity_model": {
    "ok": "duration_seconds <= warn_seconds",
    "warn": "warn_seconds < duration_seconds <= fail_seconds",
    "fail": "duration_seconds > fail_seconds"
  },
  "workflows": {
    "ci-2-analyst-diagnostics": {
      "stages": {
        "validate_wiki_governance": {
          "warn_seconds": 90,
          "fail_seconds": 240
        },
        "check_doc_freshness": {
          "warn_seconds": 45,
          "fail_seconds": 120
        },
        "content_quality_summary": {
          "warn_seconds": 45,
          "fail_seconds": 120
        },
        "lint_wiki_strict": {
          "warn_seconds": 90,
          "fail_seconds": 240
        },
        "pytest_suite": {
          "warn_seconds": 300,
          "fail_seconds": 900
        }
      }
    },
    "ci-3-pr-producer": {
      "stages": {
        "ingest_write_path": {
          "warn_seconds": 120,
          "fail_seconds": 360
        },
        "update_index_write": {
          "warn_seconds": 90,
          "fail_seconds": 240
        },
        "lint_wiki_strict": {
          "warn_seconds": 90,
          "fail_seconds": 240
        },
        "persist_query_gate": {
          "warn_seconds": 30,
          "fail_seconds": 90
        }
      }
    }
  }
}
